server {
    listen 80;
    server_name {{ ansible_facts['nodename'] }};
    server_tokens off;

    root {{ project_root }}/{{ project_name }};
    index index.php;

    client_max_body_size 11M;
    client_body_timeout 10s;
    client_header_timeout 10s;

    gzip on;
    gzip_types text/plain application/json text/xml;
    gzip_min_length 1000;

    # Denying access to sensitive data
    location ~* \.(db|ini|sql|log|class\.php)$ {
        deny all;
        return 404; # Hiding fact of file existing
    }

    # Denying access to Docker files and .md files
    location ~* ^/(\.|Dockerfile|docker-compose\.yml|README\.md) {
        deny all;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

}
